<Window x:Class="MonkeyArtInventory.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="clr-namespace:MonkeyArtInventory.App.ViewModels"
    xmlns:views="clr-namespace:MonkeyArtInventory.App.Views"
    Title="MonkeyArt Inventario" Height="720" Width="1100"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="16">
                <TextBlock Text="MonkeyArt" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="Inventario" FontSize="12" Foreground="Gray" Margin="0,0,0,16" />

                <TextBlock Text="Principal" FontWeight="Bold" Margin="0,0,0,8" />
                <StackPanel Orientation="Vertical">
                    <Button Content="Inicio" Command="{Binding ShowDashboardCommand}" Style="{StaticResource NavButton}" />
                    <Button Content="Inventario" Command="{Binding ShowInventoryCommand}" Style="{StaticResource NavButton}" />
                    <Button Content="Informes" Command="{Binding ShowReportsCommand}" Style="{StaticResource NavButton}" />
                    <Button Content="Configuración" Command="{Binding ShowSettingsCommand}" Style="{StaticResource NavButton}" />
                </StackPanel>

                <TextBlock Text="Movimientos" FontWeight="Bold" Margin="0,16,0,4" />
                <Button Content="Registrar entrada" Command="{Binding ShowEntryCommand}" />
                <Button Content="Registrar salida" Command="{Binding ShowExitCommand}" />
                <Button Content="Registrar ajuste" Command="{Binding ShowAdjustmentCommand}" />
                <Button Content="Registrar merma" Command="{Binding ShowLossCommand}" />
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Margin="12" Background="{StaticResource AppBackground}">
            <ContentControl Content="{Binding CurrentViewModel}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type viewModels:InformesDetalladoViewModel}">
                        <views:InformesDetalladoView />
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Border>
    </Grid>
</Window>
