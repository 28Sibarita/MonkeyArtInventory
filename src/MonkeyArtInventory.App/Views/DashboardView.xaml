<UserControl x:Class="MonkeyArtInventory.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel>
            <TextBlock Text="Inicio" FontSize="20" FontWeight="Bold" Margin="8" />

            <UniformGrid Columns="2" Rows="2" Margin="4">
                <Border Style="{StaticResource Card}">
                    <Button Style="{StaticResource CardButton}" Command="{Binding ShowActiveProductsCommand}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Productos activos" Foreground="Gray" />
                            </StackPanel>
                            <TextBlock Text="{Binding TotalProducts}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </Button>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Button Style="{StaticResource CardButton}" Command="{Binding ShowStockByProductsCommand}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Stock total" Foreground="Gray" />
                            </StackPanel>
                            <TextBlock Text="{Binding TotalStock}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </Button>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Button Style="{StaticResource CardButton}" Command="{Binding ShowLowStockProductsCommand}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Productos con bajo stock" Foreground="Gray" />
                            </StackPanel>
                            <TextBlock Text="{Binding LowStockCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </Button>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Button Style="{StaticResource CardButton}" Command="{Binding ShowTodayMovementsProductsCommand}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Movimientos hoy" Foreground="Gray" />
                            </StackPanel>
                            <TextBlock Text="{Binding TodayMovements}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </Button>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Detalles" FontWeight="Bold" Margin="0,0,0,8" />
                    <ListBox ItemsSource="{Binding DetailItems}" Height="200" />
                </StackPanel>
            </Border>

            <!-- Acciones rápidas removidas para evitar duplicación con la navegación principal -->
        </StackPanel>
    </ScrollViewer>
</UserControl>
