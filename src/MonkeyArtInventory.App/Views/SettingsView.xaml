<UserControl x:Class="MonkeyArtInventory.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel>
            <TextBlock Text="Configuración" FontSize="18" FontWeight="Bold" Margin="8" />

            <!-- Configuración General -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="📁 Configuración General" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                    
                    <TextBlock Text="Directorio de datos" />
                    <TextBox Text="{Binding DataDirectory}" />

                    <TextBlock Text="Ruta de la base de datos" />
                    <TextBox Text="{Binding DatabasePath}" />

                    <TextBlock Text="Directorio de reportes" />
                    <TextBox Text="{Binding ReportsDirectory}" />

                    <TextBlock Text="Moneda" />
                    <TextBox Text="{Binding Currency}" IsReadOnly="True" />

                    <CheckBox Content="Habilitar precios" IsChecked="{Binding EnablePrices}" Margin="4" />

                    <TextBlock Text="Retención de copias" />
                    <TextBox Text="{Binding BackupRetention}" />

                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="💾 Guardar configuración" Command="{Binding SaveCommand}" />
                        <Button Content="📦 Crear copia ahora" Command="{Binding CreateBackupCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Configuración de Correo Electrónico -->
            <Border Style="{StaticResource Card}" Margin="8,8,8,8">
                <StackPanel>
                    <TextBlock Text="📧 Configuración de Correo Electrónico" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                    
                    <CheckBox Content="Habilitar envío de informes por correo" IsChecked="{Binding EmailEnabled}" Margin="4,0,4,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,8,0">
                            <TextBlock Text="Servidor SMTP" />
                            <TextBox Text="{Binding SmtpServer}" IsEnabled="{Binding EmailEnabled}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" Width="80">
                            <TextBlock Text="Puerto" />
                            <TextBox Text="{Binding SmtpPort}" IsEnabled="{Binding EmailEnabled}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Usuario SMTP (correo)" Margin="0,4,0,0"/>
                    <TextBox Text="{Binding SmtpUsername}" IsEnabled="{Binding EmailEnabled}"/>

                    <TextBlock Text="Contraseña de aplicación" Margin="0,4,0,0"/>
                    <PasswordBox x:Name="PasswordBox" IsEnabled="{Binding EmailEnabled}" 
                                 PasswordChanged="PasswordBox_PasswordChanged"/>
                    <TextBlock Text="Para Gmail: usa una 'Contraseña de aplicación' desde tu cuenta Google" 
                               FontSize="10" Foreground="Gray" Margin="0,2,0,0"/>

                    <TextBlock Text="Correo remitente (From)" Margin="0,4,0,0"/>
                    <TextBox Text="{Binding EmailFrom}" IsEnabled="{Binding EmailEnabled}"/>

                    <TextBlock Text="Correo(s) destinatario(s) (separar con ; o ,)" Margin="0,4,0,0"/>
                    <TextBox Text="{Binding EmailTo}" IsEnabled="{Binding EmailEnabled}"/>

                    <CheckBox Content="Usar SSL/TLS" IsChecked="{Binding UseSsl}" IsEnabled="{Binding EmailEnabled}" Margin="4,8,4,0" />

                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="📨 Enviar correo de prueba" 
                                Command="{Binding SendTestEmailCommand}" 
                                IsEnabled="{Binding EmailEnabled}"/>
                    </WrapPanel>

                    <!-- Instrucciones para Gmail -->
                    <Border Background="#FFF3E0" CornerRadius="4" Padding="8" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="📋 Instrucciones para Gmail:" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0">
1. Ve a tu cuenta de Google → Seguridad
2. Activa la verificación en dos pasos
3. Busca "Contraseñas de aplicación"
4. Crea una nueva contraseña para "Correo"
5. Usa esa contraseña (16 caracteres) aquí
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Configuración de Automatización -->
            <Border Style="{StaticResource Card}" Margin="8,8,8,8">
                <StackPanel>
                    <TextBlock Text="⏰ Envío Automático de Informes" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                    
                    <CheckBox Content="Habilitar envío automático semanal" IsChecked="{Binding SchedulerEnabled}" Margin="4,0,4,8" />

                    <TextBlock Text="Día de la semana:" Margin="0,4,0,0"/>
                    <ComboBox ItemsSource="{Binding DayOptions}" 
                              SelectedItem="{Binding SelectedDay}" 
                              DisplayMemberPath="Label"
                              IsEnabled="{Binding SchedulerEnabled}"
                              Width="200" HorizontalAlignment="Left"/>

                    <TextBlock Text="Hora de envío:" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding HourOptions}" 
                                  SelectedItem="{Binding SchedulerHour}" 
                                  IsEnabled="{Binding SchedulerEnabled}"
                                  Width="70"/>
                        <TextBlock Text=" : " VerticalAlignment="Center" FontWeight="Bold"/>
                        <ComboBox ItemsSource="{Binding MinuteOptions}" 
                                  SelectedItem="{Binding SchedulerMinute}" 
                                  IsEnabled="{Binding SchedulerEnabled}"
                                  Width="70"/>
                    </StackPanel>

                    <!-- Estado del scheduler -->
                    <Border Background="#E3F2FD" CornerRadius="4" Padding="8" Margin="0,12,0,0">
                        <TextBlock Text="{Binding SchedulerStatus}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Botón enviar ahora para probar -->
                    <Button Content="📧 Enviar Informe Ahora (Probar)" 
                            Command="{Binding SendScheduledReportNowCommand}" 
                            Background="#4CAF50" Foreground="White"
                            Padding="12,8" Margin="0,12,0,0" HorizontalAlignment="Left"
                            IsEnabled="{Binding IsSendingScheduledReport, Converter={StaticResource InverseBoolConverter}, FallbackValue=True}"/>
                    <TextBlock Text="Enviando..." FontStyle="Italic" Foreground="Gray" 
                               Visibility="{Binding IsSendingScheduledReport, Converter={StaticResource BoolToVisibility}}"
                               Margin="0,4,0,0"/>

                    <!-- Información adicional -->
                    <Border Background="#F3E5F5" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="ℹ️ Información:" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0">
• La configuración se guarda automáticamente
• La app debe estar abierta para enviar automáticamente
• Usa el botón "Enviar Ahora" para probar la configuración
• El informe se guardará también en la carpeta de reportes
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
