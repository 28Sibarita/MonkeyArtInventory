<UserControl x:Class="MonkeyArtInventory.App.Views.ProductDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel>
            <TextBlock Text="Detalle de producto" FontSize="18" FontWeight="Bold" Margin="8" />

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <WrapPanel>
                            <StackPanel Width="240">
                                <TextBlock Text="Nombre" />
                                <TextBox Text="{Binding Name}" />
                            </StackPanel>
                            <StackPanel Width="200">
                                <TextBlock Text="Tipo" />
                                <ComboBox ItemsSource="{Binding TypeOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedType}" />
                            </StackPanel>
                        </WrapPanel>

                        <WrapPanel>
                            <StackPanel Width="240">
                                <TextBlock Text="Código de barras" />
                                <TextBox Text="{Binding Barcode}" />
                            </StackPanel>
                            <StackPanel Width="200">
                                <TextBlock Text="Stock mínimo" />
                                <TextBox Text="{Binding StockMinimo}" />
                            </StackPanel>
                            <StackPanel Width="160">
                                <TextBlock Text="Stock actual" />
                                <TextBox Text="{Binding CurrentStock}" IsReadOnly="True" />
                            </StackPanel>
                        </WrapPanel>

                        <WrapPanel>
                            <StackPanel Width="240">
                                <TextBlock Text="Ubicación" />
                                <TextBox Text="{Binding Location}" />
                            </StackPanel>
                            <StackPanel Width="200" Visibility="{Binding EnablePrices, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Precio de venta" />
                                <TextBox Text="{Binding SalePrice}" />
                            </StackPanel>
                        </WrapPanel>

                        <CheckBox Content="Activo" IsChecked="{Binding IsActive}" Margin="4" />

                        <WrapPanel>
                            <Button Content="Guardar" Command="{Binding SaveCommand}" />
                            <Button Content="Cancelar" Command="{Binding CancelCommand}" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8">
                        <Border Height="180" Background="#FFF0F0F0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathToBitmapConverter}}" Stretch="UniformToFill" />
                                <TextBlock Text="Sin imagen" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding ImagePath, Converter={StaticResource NullToVisibility}}" />
                            </Grid>
                        </Border>
                        <TextBox Text="{Binding ImagePath}" IsReadOnly="True" />
                        <Button Content="Seleccionar imagen" Command="{Binding BrowseImageCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
