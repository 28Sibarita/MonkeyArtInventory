<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MonkeyArtInventory.Mobile.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
             x:Class="MonkeyArtInventory.Mobile.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <ScrollViewer>
        <StackPanel Spacing="16" Margin="16">
            <!-- Header -->
            <TextBlock Text="📊 Dashboard" FontSize="24" FontWeight="Bold" Foreground="#2D3748" />

            <!-- Stats Cards -->
            <Border Background="White" CornerRadius="12" Padding="16">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                    <!-- Total Products -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#EBF4FF" CornerRadius="8" Padding="16" Margin="0,0,8,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📦" FontSize="28" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding TotalProducts}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#3182CE" />
                            <TextBlock Text="Productos" FontSize="12" Foreground="#718096" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Low Stock -->
                    <Border Grid.Row="0" Grid.Column="1" Background="#FFF5F5" CornerRadius="8" Padding="16" Margin="8,0,0,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="28" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding LowStockCount}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#E53E3E" />
                            <TextBlock Text="Stock Bajo" FontSize="12" Foreground="#718096" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Today Movements -->
                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="#F0FFF4" CornerRadius="8" Padding="16" Margin="0,8,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📋" FontSize="28" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding TodayMovements}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#38A169" />
                            <TextBlock Text="Movimientos Hoy" FontSize="12" Foreground="#718096" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Low Stock List -->
            <Border Background="White" CornerRadius="12" Padding="16" IsVisible="{Binding LowStockProducts.Count}">
                <StackPanel Spacing="8">
                    <TextBlock Text="⚠️ Productos con Stock Bajo" FontWeight="Bold" FontSize="16" Foreground="#E53E3E" />
                    <ItemsControl ItemsSource="{Binding LowStockProducts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFF5F5" CornerRadius="8" Padding="12" Margin="0,4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Stock}" FontWeight="Bold" Foreground="#E53E3E" VerticalAlignment="Center" />
                                            <TextBlock Text="/" Foreground="#718096" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StockMinimo}" Foreground="#718096" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
