<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MonkeyArtInventory.Mobile.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
             x:Class="MonkeyArtInventory.Mobile.Views.InventoryView"
             x:DataType="vm:InventoryViewModel">

    <Grid RowDefinitions="Auto,*">
        <!-- Search Bar -->
        <Border Background="White" Padding="12" CornerRadius="0,0,12,12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding SearchText}" Watermark="🔍 Buscar producto..." CornerRadius="20" Padding="16,8" />
                <Button Grid.Column="1" Content="Buscar" Command="{Binding SearchCommand}" Margin="8,0,0,0" CornerRadius="20" />
            </Grid>
        </Border>

        <!-- Product List -->
        <ScrollViewer Grid.Row="1" Margin="8">
            <ItemsControl ItemsSource="{Binding Products}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="12" Padding="16" Margin="4,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" />
                                    <TextBlock Text="{Binding Barcode}" Foreground="#718096" FontSize="12" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="#EBF4FF" CornerRadius="4" Padding="8,4">
                                            <TextBlock Text="{Binding TypeLabel}" FontSize="11" Foreground="#3182CE" />
                                        </Border>
                                        <Border Background="#F0FFF4" CornerRadius="4" Padding="8,4">
                                            <TextBlock Text="{Binding Location, FallbackValue='-'}" FontSize="11" Foreground="#38A169" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Stock}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#2D3748" />
                                    <TextBlock Text="en stock" FontSize="11" Foreground="#718096" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Loading Indicator -->
        <Border Grid.Row="1" Background="#80000000" IsVisible="{Binding IsLoading}">
            <TextBlock Text="Cargando..." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="18" />
        </Border>
    </Grid>
</UserControl>
