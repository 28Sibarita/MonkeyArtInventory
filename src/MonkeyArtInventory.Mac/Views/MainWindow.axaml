<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MonkeyArtInventory.Mac.ViewModels"
        xmlns:views="using:MonkeyArtInventory.Mac.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="MonkeyArtInventory.Mac.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Monkey Art Inventory"
        Width="1000" Height="700"
        WindowStartupLocation="CenterScreen">

    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClientsViewModel}">
            <views:ClientsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MovementEntryViewModel}">
            <views:MovementEntryView />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid ColumnDefinitions="200,*">
        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="#2D3748" Padding="10">
            <StackPanel Spacing="10">
                <TextBlock Text="🎨 Monkey Art" FontSize="18" FontWeight="Bold" 
                           Foreground="White" Margin="0,10,0,20" HorizontalAlignment="Center"/>
                
                <Button Command="{Binding NavigateToDashboardCommand}" 
                        Content="📊 Dashboard" HorizontalAlignment="Stretch"
                        Background="#4A5568" Foreground="White" Padding="10"/>
                
                <Button Command="{Binding NavigateToInventoryCommand}" 
                        Content="📦 Inventario" HorizontalAlignment="Stretch"
                        Background="#4A5568" Foreground="White" Padding="10"/>

                <Button Command="{Binding NavigateToClientsCommand}" 
                        Content="👥 Clientes" HorizontalAlignment="Stretch"
                        Background="#4A5568" Foreground="White" Padding="10"/>

                <TextBlock Text="Movimientos" Foreground="#A0AEC0" FontSize="12" Margin="0,10,0,5"/>

                <Button Command="{Binding NavigateToEntryCommand}" 
                        Content="📥 Entrada" HorizontalAlignment="Stretch"
                        Background="#38A169" Foreground="White" Padding="10"/>

                <Button Command="{Binding NavigateToExitCommand}" 
                        Content="📤 Salida" HorizontalAlignment="Stretch"
                        Background="#E53E3E" Foreground="White" Padding="10"/>
                
                <Button Command="{Binding NavigateToSettingsCommand}" 
                        Content="⚙️ Configuración" HorizontalAlignment="Stretch"
                        Background="#4A5568" Foreground="White" Padding="10"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Border Grid.Column="1" Background="#F7FAFC" Padding="20">
            <StackPanel>
                <TextBlock Text="{Binding CurrentViewName}" FontSize="24" FontWeight="Bold" 
                           Foreground="#2D3748" Margin="0,0,0,20"/>
                <ContentControl Content="{Binding CurrentView}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
